# Токен от @BotFather. Сменили бота — поменяйте здесь и перезапустите.
BOT_TOKEN=123456:ABC-DEF
# Telegram ID владельцев через запятую (у них все права, /admin)
OWNER_IDS=123456789
# Папка с базой, картинками и бэкапами — её и переносить при переезде
DATA_DIR=data
LOG_LEVEL=INFO
# Ключ шифрования токенов зеркал и запасных ботов. Длинная случайная строка.
# СОХРАНИТЕ ЕЁ ОТДЕЛЬНО от бэкапа: без неё сохранённые токены из бэкапа не открыть.
# Не задан - зеркала и запасные токены выключены.
SECRET_KEY=
# Веб-панель (запасные токены, зеркала, уведомления). Порт 0 или пусто - выключена.
# Слушает только 127.0.0.1: открывайте через SSH-туннель или прокси с HTTPS.
WEB_PORT=0
WEB_PASSWORD=
