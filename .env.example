# Токен основного бота от @BotFather
BOT_TOKEN=

# Telegram ID владельцев через запятую
OWNER_IDS=

# Пароль базы и ключ шифрования токенов клонов: install.sh создаст их сам.
# SECRET_KEY нельзя менять, пока есть клоны: их токены перестанут расшифровываться.
POSTGRES_PASSWORD=
SECRET_KEY=

# Только для запуска без Docker. В Docker адрес задаётся в docker-compose.yml.
# DATABASE_URL=postgresql://modbot:пароль@localhost:5432/modbot

LOG_LEVEL=INFO
